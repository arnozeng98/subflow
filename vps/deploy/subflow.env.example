# Sensitive value. Do not commit a real production token into Git.
# This should only exist on the target VPS, typically as /etc/subflow/subflow.env.
SUBFLOW_API_TOKEN=replace-me

# Bind only to localhost when Cloudflare Pages is the public gateway.
SUBFLOW_LISTEN_HOST=127.0.0.1
SUBFLOW_LISTEN_PORT=28080

# sing-box runtime files (created by the bundled manager / the `s` command).
SUBFLOW_CONFIG_PATH=/etc/sing-box/config.json
SUBFLOW_USER_DB_PATH=/etc/sing-box-manager/user-manager.json
SUBFLOW_META_PATH=/etc/sing-box-manager/meta.json

# Public host or IP embedded into generated node links. REQUIRED: this becomes
# the server address of every node. Use the address clients should connect to.
SUBFLOW_PUBLIC_IP=203.0.113.10

# Optional WS host overrides (set when VLESS-WS / VMess-WS sit behind a CDN).
SUBFLOW_WS_DOMAIN=ws.example.com
SUBFLOW_VMESS_WS_DOMAIN=vmess-ws.example.com

# Keep disabled users hidden by default so nonexistent and disabled users look identical.
SUBFLOW_INCLUDE_DISABLED_USERS=false
